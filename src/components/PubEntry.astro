---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Bibtex from './Bibtex.astro';
import VideoLoop from './VideoLoop.astro';
import { primaryLink, type Pub } from '../lib/content';

interface Props {
  pub: Pub;
}
const { pub } = Astro.props;

// Posters are files in src/assets/media/, referenced by file name in publications.yaml.
const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/media/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const poster = pub.media.poster
  ? Object.entries(posters).find(([path]) => path.endsWith('/' + pub.media.poster))?.[1].default
  : undefined;
if (pub.media.poster && !poster) {
  throw new Error(`publications.yaml: poster "${pub.media.poster}" (${pub.id}) was not found in src/assets/media/`);
}

const href = primaryLink(pub);
const Media = href ? 'a' : 'div';

// Meta line: "venue year" · award · contribution tag · corresponding author.
const year = pub.year > 0 ? String(pub.year) : '[year]';
let venueLine: string;
if (pub.status === 'preprint') {
  venueLine = `Preprint ${year}`; // the venue is never shown for a preprint
} else if (pub.status === 'workshop' && / Workshop\b/.test(pub.venue)) {
  venueLine = pub.venue.replace(/ Workshop\b/, ` ${year} Workshop`); // "NeurIPS 2025 Workshop on ..."
} else {
  venueLine = [pub.venue, year].filter(Boolean).join(' ');
}
const tag = { first: 'first author', 'co-first': 'co-first author', other: '' }[pub.contribution];
const meta = [venueLine, pub.award, tag, pub.corresponding && 'corresponding author'].filter(Boolean).join(' · ');

const bibId = `bib-${pub.id}`;
const links = [
  { label: 'paper', href: pub.links.paper },
  { label: 'arXiv', href: pub.links.arxiv },
  { label: 'project', href: pub.links.project },
  { label: 'code', href: pub.links.code },
  { label: 'video', href: pub.links.video },
  { label: 'bibtex', href: pub.bibtex.trim() ? `#${bibId}` : undefined, bibtex: true },
].filter((l) => l.href);
---

<article id={pub.id} class="row pub">
  <div class="rail media-rail">
    <Media
      class:list={['media', 'poster', { image: poster }]}
      href={href}
      aria-label={href ? pub.title : undefined}
      tabindex={href ? -1 : undefined}
      data-loop-host={pub.media.loop ? '' : undefined}
      style={poster && pub.media.background ? `background:${pub.media.background}` : undefined}
    >
      {
        poster ? (
          <Picture
            src={poster}
            alt=""
            formats={['avif', 'webp']}
            widths={[200, 400, 600, 720]}
            sizes="(max-width: 567px) min(360px, calc(100vw - 48px)), 200px"
            loading="lazy"
            decoding="async"
          />
        ) : (
          !pub.media.loop && <span class="media-label">Poster + loop</span>
        )
      }
      {pub.media.loop && <VideoLoop src={pub.media.loop} />}
    </Media>
  </div>
  <div class="main">
    <h4>{href ? <a href={href}>{pub.title}</a> : pub.title}</h4>
    <p class="authors">
      {
        pub.authors.map((a, i) => (
          <>
            {a.self ? <b>{a.name}</b> : a.name}
            {a.equal && '*'}
            {i < pub.authors.length - 1 && ', '}
          </>
        ))
      }
    </p>
    <p class="meta venue">{meta}</p>
    <p class="result">{pub.result}</p>
    {
      links.length > 0 && (
        <p class="linkrow">
          {links.map((l, i) => (
            <>
              {l.bibtex ? (
                <a href={l.href} data-bibtex-toggle aria-controls={bibId} aria-expanded="false">
                  {l.label}
                </a>
              ) : (
                <a href={l.href}>{l.label}</a>
              )}
              {i < links.length - 1 && <span class="sep" aria-hidden="true">/</span>}
            </>
          ))}
        </p>
      )
    }
    {pub.bibtex.trim() && <Bibtex id={bibId} bibtex={pub.bibtex} />}
  </div>
</article>

<style>
  .pub { gap: 14px var(--gap); scroll-margin-top: var(--s-5); }
  .media-rail { max-width: 360px; }
  .poster {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: flex-end;
    padding: 10px;
  }
  /* Figures from papers sit whole on white; they are never cropped, dimmed or inverted. */
  .poster.image { background: #fff; }
  .poster :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  h4 {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    font-weight: 600;
  }
  .authors {
    margin-top: 6px;
    font-family: var(--font-sans);
    font-size: var(--fs-authors);
    line-height: var(--lh-authors);
    font-weight: 400;
    color: var(--ink-2);
  }
  .authors b { color: var(--ink); }
  .venue { margin-top: 4px; }
  .result {
    margin-top: 8px;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    font-weight: 400;
  }
  .linkrow { margin-top: 8px; }
</style>
