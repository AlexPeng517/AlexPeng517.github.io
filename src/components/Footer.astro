---
import { execSync } from 'node:child_process';
import { getSite } from '../lib/content';

// `updated` from site.yaml; else the date of the latest git commit; else the build date.
const site = await getSite();
let updated = new Date().toISOString().slice(0, 10);
if (site.updated) {
  updated = site.updated;
} else {
  try {
    const fromGit = execSync('git log -1 --format=%cs', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
    if (/^\d{4}-\d{2}-\d{2}$/.test(fromGit)) updated = fromGit;
  } catch {}
}
---

<footer>
  <span>Updated <time datetime={updated}>{updated}</time></span>
  <span class="theme" data-theme-toggle hidden>
    <button type="button" class="textbtn" data-set-theme="light">Light</button>{' / '}<button
      type="button"
      class="textbtn"
      data-set-theme="dark">Dark</button
    >
  </span>
  <span>Layout descends from Jon Barron's site</span>
</footer>

<script>
  import '../scripts/theme.ts';
</script>

<style>
  footer {
    margin-top: 72px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px var(--gap);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    line-height: 18px;
    font-weight: 400;
    color: var(--ink-3);
  }
</style>
